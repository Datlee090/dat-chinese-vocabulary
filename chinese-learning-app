<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SỔ GHI TỪ VỰNG</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: Inter, 'Noto Sans SC', sans-serif; }
    button:disabled { opacity: .45; cursor: not-allowed; }
    .hanzi { font-family: 'Noto Sans SC', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-red-50 via-amber-50 to-orange-100 min-h-screen text-slate-800 flex flex-col">
<header class="bg-white/90 backdrop-blur-md shadow-sm border-b border-red-100 sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col lg:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="bg-red-600 text-white w-10 h-10 rounded-xl flex items-center justify-center font-bold text-xl shadow-lg">中</div>
      <div>
        <h1 class="text-xl font-bold bg-gradient-to-r from-red-600 to-amber-600 bg-clip-text text-transparent">SỔ GHI TỪ VỰNG</h1>
        <p class="text-xs text-slate-500">Tra cứu • Quản lý nhóm chủ đề • Luyện tập</p>
      </div>
    </div>
    <nav class="flex flex-wrap justify-center bg-slate-100 p-1 rounded-xl gap-1">
      <button data-tab="dictionary" onclick="switchTab('dictionary')" class="tab-btn px-3 py-2 text-sm font-semibold rounded-lg bg-white text-red-600 shadow-sm">📖 Tra cứu</button>
      <button data-tab="addword" onclick="switchTab('addword')" class="tab-btn px-3 py-2 text-sm font-semibold rounded-lg text-slate-600">➕ Từ vựng</button>
      <button data-tab="groups" onclick="switchTab('groups')" class="tab-btn px-3 py-2 text-sm font-semibold rounded-lg text-slate-600">🗂️ Nhóm chủ đề</button>
      <button data-tab="practice" onclick="switchTab('practice')" class="tab-btn px-3 py-2 text-sm font-semibold rounded-lg text-slate-600">✍️ Luyện tập</button>
    </nav>
  </div>
</header>

<main class="max-w-5xl w-full mx-auto px-4 py-8 flex-grow space-y-6">
  <!-- TRA CỨU -->
  <section id="tab-dictionary" class="tab-panel space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <h2 class="text-lg font-bold mb-2">Tra cứu từ vựng Hán tự</h2>
      <p class="text-sm text-slate-500 mb-5">Tìm bằng chữ Hán, Pinyin hoặc nghĩa tiếng Việt, bao gồm từ bạn tự thêm.</p>
      <form id="search-form" class="flex flex-col sm:flex-row gap-3">
        <input id="search-input" class="flex-grow px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500" placeholder="Ví dụ: 苹果, píngguǒ hoặc quả táo">
        <button class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-xl">🔍 Tra cứu</button>
      </form>
      <div class="mt-4 flex flex-wrap gap-2 text-xs items-center">
        <span class="text-slate-400 font-medium">Gợi ý nhanh:</span>
        <button type="button" onclick="quickSearch('你好')" class="px-3 py-1 bg-red-50 text-red-600 rounded-lg">你好</button>
        <button type="button" onclick="quickSearch('学习')" class="px-3 py-1 bg-red-50 text-red-600 rounded-lg">学习</button>
        <button type="button" onclick="quickSearch('中国')" class="px-3 py-1 bg-red-50 text-red-600 rounded-lg">中国</button>
        <button type="button" onclick="quickSearch('爱')" class="px-3 py-1 bg-red-50 text-red-600 rounded-lg">爱</button>
      </div>
    </div>
    <div id="search-result" class="hidden bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100"></div>
    <div id="search-not-found" class="hidden bg-white rounded-2xl shadow-xl p-8 text-center text-slate-500">
      Không tìm thấy từ này. Bạn có thể thêm từ ở mục <button class="text-red-600 underline font-semibold" onclick="switchTab('addword')">Từ vựng</button>.
    </div>
  </section>

  <!-- TỪ VỰNG -->
  <section id="tab-addword" class="tab-panel hidden space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <div class="flex flex-wrap justify-between items-start gap-3 mb-5">
        <div><h2 id="word-form-title" class="text-lg font-bold">Thêm từ vựng của riêng bạn</h2><p class="text-sm text-slate-500">Từ đã lưu sẽ dùng được trong tra cứu, nhóm chủ đề và luyện tập.</p></div>
        <span id="total-custom-count" class="text-xs bg-red-50 text-red-600 px-3 py-1 rounded-full font-bold">0 từ tự thêm</span>
      </div>
      <form id="word-form" class="space-y-4">
        <input type="hidden" id="edit-word-id">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Chữ Hán *
            <input id="new-hanzi" required class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-lg" placeholder="苹果">
          </label>
          <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Pinyin *
           <input id="new-pinyin" required autocomplete="off"
  class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl"
  placeholder="Nhập Pinyin, ví dụ: pingguo">
<p class="text-xs text-slate-400 mt-1">
  Nhập chữ Hán để tự tạo Pinyin có dấu; Pinyin không dấu được nhận diện nếu khớp từ trong kho.
</p> 
          </label>
          <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Hán Việt
            <input id="new-hanviet" class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Bình quả">
          </label>
        </div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Nghĩa tiếng Việt *
          <input id="new-meaning" required class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Quả táo">
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Câu ví dụ tiếng Trung
            <input id="new-ex-cn" class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl" placeholder="我喜欢吃苹果。">
          </label>
          <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Nghĩa câu ví dụ
            <input id="new-ex-vi" class="mt-1 normal-case tracking-normal w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Tôi thích ăn táo.">
          </label>
        </div>
        <div class="flex flex-wrap gap-3 justify-end pt-2">
          <button id="cancel-edit-btn" type="button" onclick="cancelWordEdit()" class="hidden px-5 py-3 rounded-xl border border-slate-200 font-semibold">Hủy sửa</button>
          <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg"><i class="fa-solid fa-floppy-disk mr-2"></i><span id="save-word-label">Lưu từ vựng</span></button>
        </div>
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <h3 class="font-bold">Danh sách từ đã thêm</h3>
        <div class="flex flex-wrap gap-2">
          <input id="word-list-search" oninput="renderCustomWordsList()" class="px-3 py-2 text-sm border border-slate-200 rounded-lg" placeholder="Lọc từ...">
          <button onclick="exportData()" class="text-xs bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-lg font-semibold">Xuất sao lưu</button>
          <button onclick="document.getElementById('import-file').click()" class="text-xs bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-lg font-semibold">Nhập sao lưu</button>
          <input id="import-file" type="file" accept="application/json,.json" class="hidden" onchange="importData(event)">
          <button onclick="clearCustomWords()" class="text-xs text-rose-600 hover:underline px-2">Xóa tất cả từ tự thêm</button>
        </div>
      </div>
      <div id="custom-words-list" class="space-y-3"></div>
    </div>
  </section>

  <!-- NHÓM CHỦ ĐỀ -->
  <section id="tab-groups" class="tab-panel hidden space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <h2 class="text-lg font-bold mb-2">Tạo nhóm từ theo chủ đề</h2>
      <p class="text-sm text-slate-500 mb-5">Mỗi từ có thể nằm trong nhiều nhóm. Xóa nhóm không xóa từ vựng.</p>
      <form id="group-form" class="flex flex-col sm:flex-row gap-3">
        <input id="new-group-name" required maxlength="60" class="flex-grow px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Ví dụ: Đồ ăn, Gia đình, Trường học...">
        <button class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-xl"><i class="fa-solid fa-folder-plus mr-2"></i>Tạo nhóm</button>
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div><h3 class="font-bold">Quản lý nhóm</h3><p class="text-xs text-slate-500 mt-1">Chọn nhóm để thêm hoặc bỏ từ, đổi tên, hoặc bắt đầu luyện tập.</p></div>
        <select id="group-select" onchange="renderGroupManager()" class="px-3 py-2 border border-slate-200 rounded-xl bg-white"><option value="">— Chọn nhóm —</option></select>
      </div>
      <div id="group-manager" class="space-y-4"></div>
    </div>
  </section>

  <!-- LUYỆN TẬP -->
  <section id="tab-practice" class="tab-panel hidden space-y-6">
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-5 flex items-center justify-between"><div><p class="text-xs text-emerald-600 uppercase font-bold">Đúng</p><h3 id="score-correct" class="text-3xl font-bold text-emerald-700 mt-1">0</h3></div><div class="w-12 h-12 bg-emerald-500 text-white rounded-xl flex items-center justify-center text-xl">✓</div></div>
      <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 flex items-center justify-between"><div><p class="text-xs text-rose-600 uppercase font-bold">Sai</p><h3 id="score-incorrect" class="text-3xl font-bold text-rose-700 mt-1">0</h3></div><div class="w-12 h-12 bg-rose-500 text-white rounded-xl flex items-center justify-center text-xl">✕</div></div>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div><h2 class="font-bold text-lg">Luyện tập trắc nghiệm</h2><p id="practice-source-label" class="text-sm text-slate-500">Nguồn: Toàn bộ từ vựng</p></div>
        <div class="flex flex-wrap gap-2">
          <select id="practice-group-select" onchange="startPracticeForSelection()" class="px-3 py-2 border border-slate-200 rounded-xl bg-white"><option value="__all__">Toàn bộ từ vựng</option></select>
          <button onclick="resetPractice()" class="text-xs text-red-600 font-semibold bg-red-50 px-3 py-2 rounded-lg">🔄 Làm lại</button>
        </div>
      </div>
      <div id="practice-empty" class="hidden text-center py-10">
        <div class="text-4xl mb-3">📚</div><h3 class="font-bold text-slate-700">Chưa có đủ từ để luyện tập</h3><p class="text-sm text-slate-500 mt-2">Hãy thêm từ hoặc chọn nhóm có từ vựng.</p>
        <button onclick="switchTab('addword')" class="mt-4 bg-red-600 text-white px-4 py-2 rounded-xl">Thêm từ mới</button>
      </div>
      <div id="practice-content">
        <div class="flex justify-between items-center mb-5"><span id="question-counter" class="text-xs font-bold uppercase tracking-wider text-slate-400">Câu hỏi</span><span id="question-progress" class="text-xs text-slate-400"></span></div>
        <div class="text-center py-5">
          <p class="text-slate-500 text-sm mb-2">Chọn nghĩa tiếng Việt đúng cho từ:</p>
          <div id="quiz-question" class="hanzi text-6xl font-bold text-slate-800 my-4"></div>
          <div id="quiz-pinyin" class="text-amber-600 font-semibold text-lg"></div>
        </div>
        <div id="quiz-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6"></div>
        <div id="quiz-feedback" class="mt-6 p-4 rounded-xl text-center font-medium hidden"></div>
        <div class="mt-6 flex justify-end"><button id="next-btn" onclick="nextQuestion()" class="hidden bg-slate-800 hover:bg-slate-900 text-white font-semibold px-6 py-3 rounded-xl">Câu tiếp theo ➔</button></div>
      </div>
    </div>
  </section>
</main>
<footer class="bg-white border-t border-slate-100 py-4 text-center text-xs text-slate-400 mt-auto">
  <p>SỔ GHI TỪ VỰNG • Dữ liệu lưu trên trình duyệt này</p>
</footer>
<div id="toast" class="hidden fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg text-sm"></div>

<script src="https://cdn.jsdelivr.net/npm/pinyin-pro@3.26.0/dist/index.js"></script>
<script>
const STORAGE_WORDS = 'my_chinese_vocab';
const STORAGE_GROUPS = 'my_chinese_vocab_groups';

const defaultVocab = [
  {hanzi:"你好",pinyin:"Nǐ hǎo",hanviet:"Nĩ Hảo",meaning:"Xin chào",examples:[{cn:"你好！很高兴认识你。",py:"Nǐ hǎo! Hěn gāoxìng rènshì nǐ.",vi:"Xin chào! Rất vui được gặp bạn."}]},
  {hanzi:"学习",pinyin:"Xuéxí",hanviet:"Học Tập",meaning:"Học tập, nghiên cứu",examples:[{cn:"我每天都在学习中文。",py:"Wǒ měitiān dōu zài xuéxí zhōngwén.",vi:"Mỗi ngày tôi đều học tiếng Trung."}]},
  {hanzi:"中国",pinyin:"Zhōngguó",hanviet:"Trung Quốc",meaning:"Nước Trung Quốc",examples:[{cn:"中国有很多名胜古迹。",py:"Zhōngguó yǒu hěnduō míngshèng gǔ迹。",vi:"Trung Quốc có rất nhiều danh lam thắng cảnh."}]},
  {hanzi:"爱",pinyin:"Ài",hanviet:"Ái",meaning:"Yêu, thích",examples:[{cn:"我爱我的家人。",py:"Wǒ ài wǒ de jiārén.",vi:"Tôi yêu gia đình của tôi."}]},
  {hanzi:"朋友",pinyin:"Péngyǒu",hanviet:"Bằng Hữu",meaning:"Bạn bè",examples:[{cn:"他是我的好朋友。",py:"Tā shì wǒ de hǎo péngyǒu.",vi:"Anh ấy là bạn tốt của tôi."}]}
];

function safeRead(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return fallback;
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : fallback;
  } catch { return fallback; }
}
function makeId() {
  return (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(36).slice(2);
}
let customVocab = safeRead(STORAGE_WORDS, []).map(w => ({...w, id: w.id || makeId(), examples: Array.isArray(w.examples) ? w.examples : []}));
let vocabGroups = safeRead(STORAGE_GROUPS, []).map(g => ({...g, id: g.id || makeId(), wordIds: Array.isArray(g.wordIds) ? g.wordIds : []}));
let currentCorrectCount = 0, currentIncorrectCount = 0, currentQuestionIndex = 0, answeredCurrent = false;
let practiceVocab = [], currentPracticeGroup = '__all__';

function persistWords() { localStorage.setItem(STORAGE_WORDS, JSON.stringify(customVocab)); }
function persistGroups() { localStorage.setItem(STORAGE_GROUPS, JSON.stringify(vocabGroups)); }
function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
}
function getAllVocab() {
  return [
    ...defaultVocab.map((w, i) => ({...w, id:'default-' + i, isDefault:true})),
    ...customVocab.map(w => ({...w, isDefault:false}))
  ];
}
// Chuẩn hóa Pinyin để so sánh, bỏ dấu thanh điệu
function normalizePinyin(text) {
  return String(text || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/ü/g, 'v')
    .replace(/\s+/g, '');
}

// Chuyển chữ Hán sang Pinyin có dấu bằng thư viện pinyin-pro.
function hanziToPinyin(text) {
  const value = String(text || '').trim();
  if (!value || !/[\u3400-\u9FFF]/.test(value)) return '';
  try {
    if (window.pinyinPro && typeof window.pinyinPro.pinyin === 'function') {
      return window.pinyinPro.pinyin(value, { toneType: 'symbol', type: 'array' }).join(' ');
    }
  } catch (err) { console.warn('Không thể chuyển chữ Hán sang Pinyin:', err); }
  return '';
}

// Nếu Pinyin không dấu khớp từ đã có, lấy cách viết có dấu trong kho.
function recognizePinyin(input) {
  const typed = normalizePinyin(input);
  if (!typed) return '';
  const matched = getAllVocab().find(word => normalizePinyin(word.pinyin) === typed);
  return matched ? matched.pinyin : '';
}

function notify(message) {
  const toast = document.getElementById('toast');
  toast.textContent = message; toast.classList.remove('hidden');
  clearTimeout(notify.timer); notify.timer = setTimeout(() => toast.classList.add('hidden'), 2600);
}

function switchTab(tabName) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.className = 'tab-btn px-3 py-2 text-sm font-semibold rounded-lg text-slate-600 hover:text-slate-900';
  });
  document.getElementById('tab-' + tabName).classList.remove('hidden');
  const active = document.querySelector(`[data-tab="${tabName}"]`);
  if (active) active.className = 'tab-btn px-3 py-2 text-sm font-semibold rounded-lg bg-white text-red-600 shadow-sm';
  if (tabName === 'addword') renderCustomWordsList();
  if (tabName === 'groups') { renderGroupSelects(); renderGroupManager(); }
  if (tabName === 'practice') { renderGroupSelects(); startPracticeForSelection(); }
}

function searchWord() {
  const keyword = document.getElementById('search-input').value.trim().toLocaleLowerCase();
  if (!keyword) return;
  const found = getAllVocab().find(w =>
    w.hanzi.toLocaleLowerCase() === keyword ||
    (w.pinyin || '').toLocaleLowerCase() === keyword ||
    (w.meaning || '').toLocaleLowerCase().includes(keyword) ||
    (w.hanviet || '').toLocaleLowerCase().includes(keyword)
  );
  const box = document.getElementById('search-result'), notFound = document.getElementById('search-not-found');
  if (!found) { box.classList.add('hidden'); notFound.classList.remove('hidden'); return; }
  const examples = (found.examples || []).length
    ? found.examples.map(ex => `<div class="mb-3"><p class="hanzi font-semibold text-slate-800">${escapeHtml(ex.cn)}</p><p class="text-xs text-amber-600">${escapeHtml(ex.py || '')}</p><p class="text-sm text-slate-600 italic">${escapeHtml(ex.vi || '')}</p></div>`).join('')
    : '<p class="text-sm text-slate-400 italic">Chưa có câu ví dụ.</p>';
  const groups = vocabGroups.filter(g => g.wordIds.includes(found.id)).map(g => g.name);
  box.innerHTML = `
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-5 gap-4">
      <div><div class="hanzi text-5xl font-bold text-red-600 mb-2">${escapeHtml(found.hanzi)}</div><div class="text-xl font-semibold text-amber-600">${escapeHtml(found.pinyin)}</div></div>
      <div class="bg-slate-50 px-4 py-3 rounded-xl"><span class="text-xs text-slate-400 block uppercase font-bold">Hán Việt</span><span class="text-lg font-bold">${escapeHtml(found.hanviet || 'Chưa cập nhật')}</span></div>
    </div>
    <div class="py-5"><h4 class="text-xs uppercase font-bold text-slate-400 mb-1">Ý nghĩa</h4><p class="text-lg font-medium">${escapeHtml(found.meaning)}</p>
      <h4 class="text-xs uppercase font-bold text-slate-400 mt-5 mb-2">Câu ví dụ</h4>${examples}
      <h4 class="text-xs uppercase font-bold text-slate-400 mt-5 mb-2">Nhóm chủ đề</h4><p class="text-sm">${groups.length ? groups.map(escapeHtml).join(', ') : 'Chưa thuộc nhóm nào.'}</p>
    </div>`;
  box.classList.remove('hidden'); notFound.classList.add('hidden');
}
document.getElementById('search-form').addEventListener('submit', e => { e.preventDefault(); searchWord(); });
function quickSearch(word) { document.getElementById('search-input').value = word; searchWord(); }

const pinyinInput = document.getElementById('new-pinyin');
const hanziInput = document.getElementById('new-hanzi');
let pinyinWasManuallyEdited = false;

// Khi nhập chữ Hán, tự điền Pinyin có dấu. Người dùng vẫn có thể sửa lại.
hanziInput.addEventListener('input', () => {
  const generated = hanziToPinyin(hanziInput.value);
  if (generated && (!pinyinInput.value.trim() || !pinyinWasManuallyEdited)) {
    pinyinInput.value = generated;
    pinyinWasManuallyEdited = false;
  }
});

pinyinInput.addEventListener('input', () => {
  pinyinWasManuallyEdited = true;
});

// Khi rời ô Pinyin: ưu tiên từ đã có trong kho; nếu chưa có, dùng chữ Hán
// đang nhập để tạo Pinyin chính xác theo chữ Hán đó.
pinyinInput.addEventListener('blur', () => {
  const typed = pinyinInput.value.trim();
  const recognized = recognizePinyin(typed);
  if (recognized) {
    pinyinInput.value = recognized;
    return;
  }
  const generated = hanziToPinyin(hanziInput.value);
  if (generated && (!typed || normalizePinyin(generated) === normalizePinyin(typed))) {
    pinyinInput.value = generated;
  }
});

document.getElementById('word-form').addEventListener('submit', e => {
  e.preventDefault();
  const editId = document.getElementById('edit-word-id').value;
  const hanzi = document.getElementById('new-hanzi').value.trim();
  const pinyin = document.getElementById('new-pinyin').value.trim();
  const hanviet = document.getElementById('new-hanviet').value.trim();
  const meaning = document.getElementById('new-meaning').value.trim();
  const exCn = document.getElementById('new-ex-cn').value.trim();
  const exVi = document.getElementById('new-ex-vi').value.trim();
  const duplicate = getAllVocab().find(w => w.hanzi.toLocaleLowerCase() === hanzi.toLocaleLowerCase() && w.id !== editId);
  if (duplicate) { notify(`Từ "${hanzi}" đã tồn tại trong kho từ vựng.`); return; }
  const word = {id: editId || makeId(), hanzi, pinyin, hanviet: hanviet || '', meaning, examples: exCn ? [{cn:exCn, py:'', vi:exVi}] : []};
  if (editId) {
    const index = customVocab.findIndex(w => w.id === editId);
    if (index < 0) { notify('Không tìm thấy từ cần sửa.'); cancelWordEdit(); return; }
    customVocab[index] = word;
    notify('Đã cập nhật từ vựng.');
  } else {
    customVocab.push(word);
    notify(`Đã thêm từ "${hanzi}".`);
  }
  persistWords(); e.target.reset(); pinyinWasManuallyEdited = false; document.getElementById('edit-word-id').value = '';
  document.getElementById('word-form-title').textContent = 'Thêm từ vựng của riêng bạn';
  document.getElementById('save-word-label').textContent = 'Lưu từ vựng';
  document.getElementById('cancel-edit-btn').classList.add('hidden');
  renderCustomWordsList(); renderGroupSelects(); renderGroupManager();
});
function editCustomWord(id) {
  const w = customVocab.find(x => x.id === id); if (!w) return;
  document.getElementById('edit-word-id').value = w.id;
  document.getElementById('new-hanzi').value = w.hanzi || '';
  document.getElementById('new-pinyin').value = w.pinyin || '';
  pinyinWasManuallyEdited = true;
  document.getElementById('new-hanviet').value = w.hanviet || '';
  document.getElementById('new-meaning').value = w.meaning || '';
  document.getElementById('new-ex-cn').value = w.examples?.[0]?.cn || '';
  document.getElementById('new-ex-vi').value = w.examples?.[0]?.vi || '';
  document.getElementById('word-form-title').textContent = 'Sửa từ vựng';
  document.getElementById('save-word-label').textContent = 'Lưu thay đổi';
  document.getElementById('cancel-edit-btn').classList.remove('hidden');
  document.getElementById('new-hanzi').focus(); window.scrollTo({top:0, behavior:'smooth'});
}
function cancelWordEdit() {
  document.getElementById('word-form').reset();
  pinyinWasManuallyEdited = false;
  document.getElementById('edit-word-id').value = '';
  document.getElementById('word-form-title').textContent = 'Thêm từ vựng của riêng bạn';
  document.getElementById('save-word-label').textContent = 'Lưu từ vựng';
  document.getElementById('cancel-edit-btn').classList.add('hidden');
}
function renderCustomWordsList() {
  const container = document.getElementById('custom-words-list');
  document.getElementById('total-custom-count').textContent = `${customVocab.length} từ tự thêm`;
  const query = (document.getElementById('word-list-search')?.value || '').trim().toLocaleLowerCase();
  const list = customVocab.filter(w => [w.hanzi,w.pinyin,w.hanviet,w.meaning].some(v => (v || '').toLocaleLowerCase().includes(query)));
  if (!list.length) { container.innerHTML = `<p class="text-sm text-slate-400 text-center py-5">${customVocab.length ? 'Không tìm thấy từ phù hợp.' : 'Bạn chưa tự thêm từ nào.'}</p>`; return; }
  container.innerHTML = list.map(w => {
    const groups = vocabGroups.filter(g => g.wordIds.includes(w.id));
    return `<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl">
      <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><span class="hanzi text-xl font-bold text-red-600">${escapeHtml(w.hanzi)}</span><span class="text-sm font-semibold text-amber-600">${escapeHtml(w.pinyin)}</span></div><p class="text-sm text-slate-700">${escapeHtml(w.meaning)}</p><p class="text-xs text-slate-400 mt-1">Nhóm: ${groups.length ? groups.map(g => escapeHtml(g.name)).join(', ') : 'Chưa phân nhóm'}</p></div>
      <div class="flex gap-2 shrink-0"><button onclick="editCustomWord('${w.id}')" class="text-xs text-blue-600 bg-blue-50 px-3 py-2 rounded-lg"><i class="fa-solid fa-pen mr-1"></i>Sửa</button><button onclick="deleteCustomWord('${w.id}')" class="text-xs text-rose-600 bg-rose-50 px-3 py-2 rounded-lg"><i class="fa-solid fa-trash mr-1"></i>Xóa</button></div>
    </div>`;
  }).join('');
}
function deleteCustomWord(id) {
  const w = customVocab.find(x => x.id === id); if (!w) return;
  if (!confirm(`Xóa từ "${w.hanzi}"? Từ này cũng sẽ bị gỡ khỏi các nhóm chủ đề.`)) return;
  customVocab = customVocab.filter(x => x.id !== id);
  vocabGroups.forEach(g => g.wordIds = g.wordIds.filter(wordId => wordId !== id));
  persistWords(); persistGroups(); renderCustomWordsList(); renderGroupSelects(); renderGroupManager();
  if (currentPracticeGroup !== '__all__') startPracticeForSelection();
  notify('Đã xóa từ vựng.');
}
function clearCustomWords() {
  if (!customVocab.length) { notify('Không có từ tự thêm để xóa.'); return; }
  if (!confirm('Xóa toàn bộ từ tự thêm? Các từ mặc định sẽ được giữ lại.')) return;
  const ids = new Set(customVocab.map(w => w.id));
  customVocab = []; vocabGroups.forEach(g => g.wordIds = g.wordIds.filter(id => !ids.has(id)));
  persistWords(); persistGroups(); renderCustomWordsList(); renderGroupSelects(); renderGroupManager();
  notify('Đã xóa toàn bộ từ tự thêm.');
}

document.getElementById('group-form').addEventListener('submit', e => {
  e.preventDefault();
  const name = document.getElementById('new-group-name').value.trim();
  if (!name) return;
  if (vocabGroups.some(g => g.name.toLocaleLowerCase() === name.toLocaleLowerCase())) { notify('Tên nhóm này đã tồn tại.'); return; }
  vocabGroups.push({id:makeId(), name, wordIds:[]}); persistGroups();
  e.target.reset(); renderGroupSelects(); renderGroupManager(); notify(`Đã tạo nhóm "${name}".`);
});
function renderGroupSelects() {
  const managerSelect = document.getElementById('group-select');
  const practiceSelect = document.getElementById('practice-group-select');
  const managerValue = managerSelect.value;
  const practiceValue = currentPracticeGroup;
  managerSelect.innerHTML = '<option value="">— Chọn nhóm —</option>' + vocabGroups.map(g => `<option value="${g.id}">${escapeHtml(g.name)} (${g.wordIds.length})</option>`).join('');
  if (vocabGroups.some(g => g.id === managerValue)) managerSelect.value = managerValue;
  practiceSelect.innerHTML = '<option value="__all__">Toàn bộ từ vựng</option>' + vocabGroups.map(g => `<option value="${g.id}">${escapeHtml(g.name)} (${g.wordIds.length})</option>`).join('');
  practiceSelect.value = vocabGroups.some(g => g.id === practiceValue) || practiceValue === '__all__' ? practiceValue : '__all__';
}
function renderGroupManager() {
  const container = document.getElementById('group-manager');
  const groupId = document.getElementById('group-select').value;
  if (!groupId) {
    container.innerHTML = vocabGroups.length ? `<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">${vocabGroups.map(g => `<div class="border border-slate-100 bg-slate-50 rounded-xl p-4 flex items-center justify-between gap-3"><div><p class="font-semibold">${escapeHtml(g.name)}</p><p class="text-xs text-slate-500">${g.wordIds.filter(id => !!getWordById(id)).length} từ</p></div><button onclick="selectGroup('${g.id}')" class="text-sm text-red-600 font-semibold">Quản lý →</button></div>`).join('')}</div>` : '<p class="text-sm text-slate-400 text-center py-6">Bạn chưa tạo nhóm nào.</p>';
    return;
  }
  const group = vocabGroups.find(g => g.id === groupId); if (!group) return;
  const allWords = getAllVocab();
  const memberIds = new Set(group.wordIds);
  const members = allWords.filter(w => memberIds.has(w.id));
  const nonMembers = allWords.filter(w => !memberIds.has(w.id));
  container.innerHTML = `
    <div class="flex flex-col sm:flex-row gap-3">
      <input id="rename-group-input" maxlength="60" value="${escapeHtml(group.name)}" class="flex-grow px-3 py-2 border border-slate-200 rounded-xl">
      <button onclick="renameGroup('${group.id}')" class="px-4 py-2 rounded-xl bg-slate-100 font-semibold text-sm">Đổi tên</button>
      <button onclick="deleteGroup('${group.id}')" class="px-4 py-2 rounded-xl bg-rose-50 text-rose-600 font-semibold text-sm">Xóa nhóm</button>
      <button onclick="practiceGroup('${group.id}')" class="px-4 py-2 rounded-xl bg-red-600 text-white font-semibold text-sm">Luyện nhóm này</button>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="border border-slate-100 rounded-xl p-4">
        <h4 class="font-bold mb-3">Từ trong nhóm (${members.length})</h4>
        ${members.length ? `<div class="space-y-2 max-h-80 overflow-y-auto">${members.map(w => `<div class="flex items-center justify-between gap-2 bg-slate-50 rounded-lg p-3"><div><p class="hanzi font-bold text-red-600">${escapeHtml(w.hanzi)} <span class="text-xs text-amber-600 font-medium">${escapeHtml(w.pinyin)}</span></p><p class="text-sm">${escapeHtml(w.meaning)}</p></div><button onclick="removeWordFromGroup('${group.id}','${w.id}')" class="text-xs text-rose-600 px-2 py-1">Bỏ khỏi nhóm</button></div>`).join('')}</div>` : '<p class="text-sm text-slate-400">Nhóm chưa có từ nào.</p>'}
      </div>
      <div class="border border-slate-100 rounded-xl p-4">
        <h4 class="font-bold mb-1">Thêm từ vào nhóm</h4><p class="text-xs text-slate-500 mb-3">Có thể chọn nhiều từ rồi thêm cùng lúc.</p>
        <input id="group-word-filter" oninput="filterGroupWords()" class="w-full mb-3 px-3 py-2 border border-slate-200 rounded-lg text-sm" placeholder="Tìm chữ Hán, Pinyin hoặc nghĩa...">
        <div class="flex gap-2 mb-3"><button onclick="toggleGroupWordChecks(true)" class="text-xs text-blue-600">Chọn tất cả đang hiện</button><button onclick="toggleGroupWordChecks(false)" class="text-xs text-slate-500">Bỏ chọn</button></div>
        <div id="group-available-words" class="space-y-2 max-h-64 overflow-y-auto">${nonMembers.length ? nonMembers.map(w => `<label data-search="${escapeHtml((w.hanzi+' '+w.pinyin+' '+w.meaning+' '+(w.hanviet||'')).toLocaleLowerCase())}" class="group-word-option flex items-start gap-2 bg-slate-50 rounded-lg p-3 cursor-pointer"><input type="checkbox" value="${w.id}" class="group-word-checkbox mt-1"><span><span class="hanzi font-bold text-red-600">${escapeHtml(w.hanzi)}</span> <span class="text-xs text-amber-600">${escapeHtml(w.pinyin)}</span><span class="block text-sm">${escapeHtml(w.meaning)}</span></span></label>`).join('') : '<p class="text-sm text-slate-400">Tất cả từ hiện có đã nằm trong nhóm này.</p>'}</div>
        <button onclick="addSelectedWordsToGroup('${group.id}')" class="mt-4 w-full bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-3 rounded-xl">Thêm các từ đã chọn</button>
      </div>
    </div>`;
}
function selectGroup(id) { document.getElementById('group-select').value = id; renderGroupManager(); }
function renameGroup(id) {
  const group = vocabGroups.find(g => g.id === id); const input = document.getElementById('rename-group-input');
  const name = input.value.trim(); if (!name) { notify('Tên nhóm không được để trống.'); return; }
  if (vocabGroups.some(g => g.id !== id && g.name.toLocaleLowerCase() === name.toLocaleLowerCase())) { notify('Tên nhóm này đã tồn tại.'); return; }
  group.name = name; persistGroups(); renderGroupSelects(); document.getElementById('group-select').value = id; renderGroupManager(); notify('Đã đổi tên nhóm.');
}
function deleteGroup(id) {
  const group = vocabGroups.find(g => g.id === id); if (!group) return;
  if (!confirm(`Xóa nhóm "${group.name}"? Các từ vựng trong nhóm sẽ vẫn được giữ lại.`)) return;
  vocabGroups = vocabGroups.filter(g => g.id !== id); persistGroups();
  if (currentPracticeGroup === id) currentPracticeGroup = '__all__';
  renderGroupSelects(); renderGroupManager(); startPracticeForSelection(); notify('Đã xóa nhóm.');
}
function addSelectedWordsToGroup(id) {
  const group = vocabGroups.find(g => g.id === id); if (!group) return;
  const checks = [...document.querySelectorAll('.group-word-checkbox:checked')].map(c => c.value);
  if (!checks.length) { notify('Hãy chọn ít nhất một từ.'); return; }
  const validIds = new Set(getAllVocab().map(w => w.id));
  group.wordIds = [...new Set([...group.wordIds.filter(wordId => validIds.has(wordId)), ...checks.filter(wordId => validIds.has(wordId))])];
  persistGroups(); renderGroupSelects(); document.getElementById('group-select').value = id; renderGroupManager(); renderCustomWordsList(); notify(`Đã thêm ${checks.length} từ vào nhóm.`);
}
function removeWordFromGroup(groupId, wordId) {
  const group = vocabGroups.find(g => g.id === groupId); if (!group) return;
  group.wordIds = group.wordIds.filter(id => id !== wordId); persistGroups();
  renderGroupSelects(); document.getElementById('group-select').value = groupId; renderGroupManager(); renderCustomWordsList();
}
function filterGroupWords() {
  const q = document.getElementById('group-word-filter').value.trim().toLocaleLowerCase();
  document.querySelectorAll('.group-word-option').forEach(el => el.classList.toggle('hidden', !el.dataset.search.includes(q)));
}
function toggleGroupWordChecks(checked) {
  document.querySelectorAll('.group-word-option:not(.hidden) .group-word-checkbox').forEach(el => el.checked = checked);
}
function practiceGroup(id) {
  currentPracticeGroup = id; renderGroupSelects(); document.getElementById('practice-group-select').value = id; switchTab('practice');
}

function startPracticeForSelection() {
  currentPracticeGroup = document.getElementById('practice-group-select').value || '__all__';
  const group = vocabGroups.find(g => g.id === currentPracticeGroup);
  practiceVocab = currentPracticeGroup === '__all__' ? getAllVocab() : getAllVocab().filter(w => group && group.wordIds.includes(w.id));
  currentQuestionIndex = 0; answeredCurrent = false;
  loadQuestion();
}
function loadQuestion() {
  const empty = practiceVocab.length === 0;
  document.getElementById('practice-empty').classList.toggle('hidden', !empty);
  document.getElementById('practice-content').classList.toggle('hidden', empty);
  const group = vocabGroups.find(g => g.id === currentPracticeGroup);
  document.getElementById('practice-source-label').textContent = currentPracticeGroup === '__all__' ? 'Nguồn: Toàn bộ từ vựng' : `Nguồn: Nhóm ${group ? group.name : ''}`;
  if (empty) return;
  if (currentQuestionIndex >= practiceVocab.length) currentQuestionIndex = 0;
  const current = practiceVocab[currentQuestionIndex];
  answeredCurrent = false;
  document.getElementById('next-btn').classList.add('hidden');
  const feedback = document.getElementById('quiz-feedback'); feedback.className = 'mt-6 p-4 rounded-xl text-center font-medium hidden'; feedback.textContent = '';
  document.getElementById('question-counter').textContent = `Câu ${currentQuestionIndex + 1} / ${practiceVocab.length}`;
  document.getElementById('question-progress').textContent = `Đúng ${currentCorrectCount} • Sai ${currentIncorrectCount}`;
  document.getElementById('quiz-question').textContent = current.hanzi;
  document.getElementById('quiz-pinyin').textContent = current.pinyin ? `(${current.pinyin})` : '';
  const wrongAnswers = [...new Set(practiceVocab.filter(w => w.id !== current.id && w.meaning !== current.meaning).map(w => w.meaning))];
  wrongAnswers.sort(() => Math.random() - 0.5);
  const options = [current.meaning, ...wrongAnswers.slice(0, 3)];
  options.sort(() => Math.random() - 0.5);
  const optionsContainer = document.getElementById('quiz-options'); optionsContainer.innerHTML = '';
  options.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'p-4 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl font-medium text-slate-700 transition-all text-left';
    btn.textContent = opt;
    btn.onclick = () => checkAnswer(opt, current.meaning, btn);
    optionsContainer.appendChild(btn);
  });
}
function checkAnswer(selected, correct, btnElement) {
  if (answeredCurrent) return; answeredCurrent = true;
  const feedback = document.getElementById('quiz-feedback'); feedback.classList.remove('hidden');
  const buttons = [...document.getElementById('quiz-options').children];
  if (selected === correct) {
    btnElement.className = 'p-4 bg-emerald-500 text-white border border-emerald-600 rounded-xl font-medium text-left shadow-md';
    feedback.className = 'mt-6 p-4 rounded-xl text-center font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
    feedback.textContent = 'Chính xác! Bạn thật tuyệt vời 🎉';
    currentCorrectCount++;
  } else {
    btnElement.className = 'p-4 bg-rose-500 text-white border border-rose-600 rounded-xl font-medium text-left shadow-md';
    feedback.className = 'mt-6 p-4 rounded-xl text-center font-medium bg-rose-50 text-rose-700 border border-rose-200';
    feedback.textContent = `Chưa chính xác. Đáp án đúng là: "${correct}"`;
    buttons.forEach(b => { if (b.textContent === correct) b.className = 'p-4 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-xl font-medium text-left'; });
    currentIncorrectCount++;
  }
  document.getElementById('score-correct').textContent = currentCorrectCount;
  document.getElementById('score-incorrect').textContent = currentIncorrectCount;
  document.getElementById('question-progress').textContent = `Đúng ${currentCorrectCount} • Sai ${currentIncorrectCount}`;
  document.getElementById('next-btn').classList.remove('hidden');
  buttons.forEach(b => b.disabled = true);
}
function nextQuestion() { currentQuestionIndex++; loadQuestion(); }
function resetPractice() {
  currentCorrectCount = 0; currentIncorrectCount = 0; currentQuestionIndex = 0;
  document.getElementById('score-correct').textContent = '0';
  document.getElementById('score-incorrect').textContent = '0';
  loadQuestion();
}

function exportData() {
  const data = {version:1, customVocab, vocabGroups};
  const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob); const a = document.createElement('a');
  a.href = url; a.download = 'ghi-tu-vung-dat-le-sao-luu.json'; a.click(); URL.revokeObjectURL(url);
  notify('Đã xuất file sao lưu.');
}
function importData(event) {
  const file = event.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const data = JSON.parse(reader.result);
      if (!Array.isArray(data.customVocab) || !Array.isArray(data.vocabGroups)) throw new Error('invalid');
      if (!confirm('Nhập sao lưu sẽ thay thế danh sách từ tự thêm và nhóm hiện tại. Bạn có muốn tiếp tục?')) { event.target.value = ''; return; }
      customVocab = data.customVocab.map(w => ({...w, id:w.id || makeId(), examples:Array.isArray(w.examples) ? w.examples : []}));
      const ids = new Set(customVocab.map(w => w.id).concat(defaultVocab.map((_,i) => 'default-'+i)));
      vocabGroups = data.vocabGroups.map(g => ({...g, id:g.id || makeId(), wordIds:Array.isArray(g.wordIds) ? g.wordIds.filter(id => ids.has(id)) : []}));
      persistWords(); persistGroups(); renderCustomWordsList(); renderGroupSelects(); renderGroupManager(); startPracticeForSelection();
      notify('Đã nhập dữ liệu sao lưu.');
    } catch { alert('File sao lưu không hợp lệ hoặc bị lỗi.'); }
    event.target.value = '';
  };
  reader.readAsText(file);
}

// Chuẩn hóa và lưu ID cho dữ liệu cũ, không xóa các từ đã có trong localStorage.
persistWords(); persistGroups();
renderCustomWordsList(); renderGroupSelects(); renderGroupManager();
startPracticeForSelection();
</script>
